{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "lib",
    //只要推断出any类型，就会报错，但可以显示设置any
    "noImplicitAny": true,
    //打开strictNullChecks以后，undefined和null只能赋值给自身，或者any类型和unknown类型的变量。
    "strictNullChecks": true,
    "strict": true,
    //如果编译器检测到错误，就不会生成输出文件。
    "noEmitOnError ": true
  },
  "include": [
    "ts/**/*",
    "challenges/**/*",
    "src/**/*"
  ]
}